# =============================================================================
# Multi-Agent Quote Advisor — environment variables
# Copy to .env and fill in. .env is git-ignored; .env.example is committed.
# =============================================================================

# ── LLM provider keys (set whichever providers your llm_roles.yaml references)
# Default config uses OpenAI for every role - OPENAI_API_KEY is required.
# Set ANTHROPIC_API_KEY only if you flip any role to an `anthropic:*` model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── LangSmith observability (zero code changes required - configuration.py
# bootstraps this when LANGSMITH_TRACING=true). Trace URL is printed by the
# CLI when --verbose is passed. Project is filterable by thread_id.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=refocusai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Per-agent LLM overrides (highest precedence; format "provider:model")
# Examples — uncomment to override the YAML defaults in configs/llm_roles.yaml
# QA_LLM_INTENT_CLASSIFIER=openai:gpt-4o-mini
# QA_LLM_RISK_AGENT=anthropic:claude-sonnet-4-6
# QA_LLM_COUNCIL_COMPLIANCE=openai:gpt-4o

# ── Storage paths (defaults are fine for the demo)
QA_CHROMADB_DIR=./.chromadb
QA_CHECKPOINT_SQLITE=./.langgraph/checkpoints.sqlite
QA_DATA_DIR=./data
